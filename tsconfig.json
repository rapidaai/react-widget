{
    "compilerOptions": {
        "outDir": "./dist",
        "baseUrl": "./src",
        "paths": {
            "@/*": [
                "*"
            ]
        },
        "typeRoots": [
            "./node_modules/@types",
            "./src/types" // Ensure this directory contains globals.d.ts
        ],
        "target": "es6",
        "module": "commonjs",
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true
    },
    "include": [
        "src/**/*"
    ]
}